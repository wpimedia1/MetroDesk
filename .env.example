NEBIUS_API_KEY=
TAVILY_API_KEY=
NEBIUS_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
PORT=4400
HOST=127.0.0.1
# Set APP_ORIGIN to the public HTTPS origin when deployed behind a reverse proxy.
METRODESK_USERNAME=
METRODESK_PASSWORD=
# Per-request time limits in milliseconds.
METRODESK_MODEL_TIMEOUT_MS=120000
METRODESK_RESEARCH_TIMEOUT_MS=60000
# Prices for the cost meter (US dollars).
NEBIUS_INPUT_USD_PER_MILLION=1
NEBIUS_OUTPUT_USD_PER_MILLION=3
TAVILY_USD_PER_CREDIT=0.008
